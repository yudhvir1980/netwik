# Copy the names, not the values, into Vercel: Project -> Settings -> Environment Variables.
# Every one of these is server side only. None is ever read by browser code.
# For local work with `vercel dev`, put real values in .env.local, which is git ignored.

# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is also the emergency revoke.
SESSION_SECRET=

# The two accounts. Long and random: there is no real rate limiting yet,
# only a fixed delay on a failed attempt.
PASSWORD_YUDHVIR=
PASSWORD_ADMIN=

# Kill switch for anything that costs money. Nothing calls Claude unless this
# is exactly the string "true". Leave it unset to make the console read only.
LIVE_CALLS_ENABLED=false

# Claude API key. Server side only, never prefixed for client exposure.
ANTHROPIC_API_KEY=

# ServiceNow. Basic authentication with a dedicated integration user.
#
# SERVICENOW_INSTANCE is the BARE HOST only, for example dev12345.service-now.com.
# Not a login URL. Pasting a login URL puts a username and password in a query
# string that ends up in responses and logs. The server now refuses such a value
# rather than using it.
SERVICENOW_INSTANCE=
#
# Use a dedicated integration user with web service access and read roles, never
# the admin account. The console only reads today, but the credential itself is
# as powerful as the account behind it.
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Lets the data-repair endpoint write to the instance. Nothing is written
# unless this is exactly "true" AND the caller asks for apply mode. Only the
# fields on the allow-list in api/_lib/servicenow-write.js can ever change.
# Switch it back off once the repairs are done.
SERVICENOW_WRITE_ENABLED=false

# Lets the table-creation endpoint create tables and columns. A DIFFERENT
# switch from the one above on purpose: allowing record updates must never
# imply allowing schema changes. Create-only and idempotent, limited to the
# seven u_ tables defined in lib/vuln-schema.js. Switch it back off as soon
# as the tables exist.
SERVICENOW_SCHEMA_ENABLED=false
