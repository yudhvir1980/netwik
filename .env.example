# Copy the names, not the values, into Vercel: Project -> Settings -> Environment Variables.
# Every one of these is server side only. None is ever read by browser code.
# For local work with `vercel dev`, put real values in .env.local, which is git ignored.

# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is also the emergency revoke.
SESSION_SECRET=

# The two accounts. Long and random: there is no real rate limiting yet,
# only a fixed delay on a failed attempt.
PASSWORD_YUDHVIR=
PASSWORD_ADMIN=

# Kill switch for anything that costs money. Nothing calls Claude unless this
# is exactly the string "true". Leave it unset to make the console read only.
LIVE_CALLS_ENABLED=false

# Claude API key. Server side only, never prefixed for client exposure.
ANTHROPIC_API_KEY=

# ServiceNow, added when the read-only client lands. Basic authentication with
# the integration user, which holds web service access only.
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
